rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function getRole() {
      return getAdminDoc().data.role;
    }

    function isOwner() {
      return isAdmin() && getRole() == 'owner';
    }

    function isEditor() {
      return isAdmin() && (getRole() in ['owner', 'editor']);
    }

    function isStaff() {
      return isAdmin() && (getRole() in ['owner', 'receptionist', 'editor', 'viewer']);
    }

    function isOwnerOrReceptionist() {
      return isAdmin() && (getRole() in ['owner', 'receptionist']);
    }

    function hasBookingSettings() {
      return exists(/databases/$(database)/documents/booking_settings/global);
    }

    function getAutoConfirm() {
      return hasBookingSettings() && get(/databases/$(database)/documents/booking_settings/global).data.autoConfirm == true;
    }

    // --- Admins Collection ---
    // Readable only by the signed-in user for their own doc.
    // Client write is completely disabled.
    match /admins/{uid} {
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list: if isOwner();
      allow write: if false;
    }

    // --- Slots Collection (Double-booking prevention, no patient info) ---
    // Public read: wizard needs to know occupied 30-min blocks.
    // Create: requires deterministic ID `${doctorId}_${date}_${HHmm}`, existsAfter on appointment,
    // and matching doctorId and date on the appointment.
    // Delete: allowed for staff, or when released by the patient via the matching appointment & bookingLookup.
    // Update: strictly denied.
    match /slots/{slotId} {
      allow read: if true;

      allow create: if !exists(/databases/$(database)/documents/slots/$(slotId))
                    && request.resource.data.keys().hasAll(['doctorId', 'date', 'startTime', 'appointmentId'])
                    && request.resource.data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
                    && slotId == (
                      request.resource.data.doctorId + '_' +
                      request.resource.data.date + '_' +
                      (request.resource.data.startTime.split(':')[0] + request.resource.data.startTime.split(':')[1])
                    )
                    && existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
                    && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.doctorId == request.resource.data.doctorId
                    && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.date == request.resource.data.date;

      allow delete: if isOwnerOrReceptionist() || (
        exists(/databases/$(database)/documents/appointments/$(resource.data.appointmentId))
        && existsAfter(/databases/$(database)/documents/bookingLookup/$(get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.manageToken))
        && (
          getAfter(/databases/$(database)/documents/bookingLookup/$(get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.manageToken)).data.status == 'cancelled'
          || getAfter(/databases/$(database)/documents/bookingLookup/$(get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.manageToken)).data.doctorId != resource.data.doctorId
          || getAfter(/databases/$(database)/documents/bookingLookup/$(get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.manageToken)).data.date != resource.data.date
          || resource.data.startTime < getAfter(/databases/$(database)/documents/bookingLookup/$(get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.manageToken)).data.startTime
          || resource.data.startTime >= getAfter(/databases/$(database)/documents/bookingLookup/$(get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.manageToken)).data.endTime
        )
      );

      allow update: if false;
    }

    // --- Appointments Collection (Contains patient data) ---
    // Public clients must NOT be able to list or read appointments.
    // Public create allowed only with valid fields and without internalNotes.
    // Patient update allowed ONLY when synchronized with bookingLookup via manageToken.
    // Staff update/delete allowed for owner/receptionist.
    match /appointments/{appointmentId} {
      allow create: if request.resource.data.status in ['pending', 'confirmed']
                    && request.resource.data.keys().hasAll(['patientName', 'patientPhone', 'serviceId', 'date', 'startTime', 'bookingCode', 'manageToken', 'doctorId'])
                    && !('internalNotes' in request.resource.data)
                    && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.doctorId + '_' + request.resource.data.date + '_' + (request.resource.data.startTime.split(':')[0] + request.resource.data.startTime.split(':')[1])))
                    && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.doctorId + '_' + request.resource.data.date + '_' + (request.resource.data.startTime.split(':')[0] + request.resource.data.startTime.split(':')[1]))).data.appointmentId == appointmentId;

      allow read: if isStaff();

      allow update: if isOwnerOrReceptionist() || (
        resource.data.status in ['pending', 'confirmed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'cancellationReason', 'date', 'startTime', 'endTime', 'doctorId', 'updatedAt'
        ])
        && existsAfter(/databases/$(database)/documents/bookingLookup/$(resource.data.manageToken))
        && getAfter(/databases/$(database)/documents/bookingLookup/$(resource.data.manageToken)).data.status == request.resource.data.status
        && getAfter(/databases/$(database)/documents/bookingLookup/$(resource.data.manageToken)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/bookingLookup/$(resource.data.manageToken)).data.startTime == request.resource.data.startTime
        && getAfter(/databases/$(database)/documents/bookingLookup/$(resource.data.manageToken)).data.endTime == request.resource.data.endTime
        && getAfter(/databases/$(database)/documents/bookingLookup/$(resource.data.manageToken)).data.doctorId == request.resource.data.doctorId
        && (
          request.resource.data.status == 'cancelled'
          || (
            request.resource.data.status == (getAutoConfirm() == true ? 'confirmed' : 'pending')
            && (
              !(request.resource.data.date != resource.data.date || request.resource.data.startTime != resource.data.startTime || request.resource.data.doctorId != resource.data.doctorId)
              || (
                existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.doctorId + '_' + request.resource.data.date + '_' + (request.resource.data.startTime.split(':')[0] + request.resource.data.startTime.split(':')[1])))
                && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.doctorId + '_' + request.resource.data.date + '_' + (request.resource.data.startTime.split(':')[0] + request.resource.data.startTime.split(':')[1]))).data.appointmentId == appointmentId
              )
            )
          )
        )
      );

      allow delete: if isOwnerOrReceptionist();
    }

    // --- BookingLookup Collection (Patient self-service without login) ---
    // Public get by exact token ID is allowed; list is NEVER public.
    // Create requires matching appointment existsAfter and manageToken equals document ID.
    // Update allowed only for patient self-service (status -> cancelled, or reschedule pending/confirmed).
    match /bookingLookup/{token} {
      allow get: if true;
      allow list: if isStaff();

      allow create: if request.resource.data.status in ['pending', 'confirmed']
                    && existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
                    && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.manageToken == token;

      allow update: if isOwnerOrReceptionist() || (
        resource.data.status in ['pending', 'confirmed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'cancellationReason', 'updatedAt', 'date', 'startTime', 'endTime', 'doctorId'
        ])
        && existsAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId))
        && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status == request.resource.data.status
        && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.startTime == request.resource.data.startTime
        && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.endTime == request.resource.data.endTime
        && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.doctorId == request.resource.data.doctorId
        && (
          request.resource.data.status == 'cancelled'
          || (
            request.resource.data.status == (getAutoConfirm() == true ? 'confirmed' : 'pending')
            && (
              !(request.resource.data.date != resource.data.date || request.resource.data.startTime != resource.data.startTime || request.resource.data.doctorId != resource.data.doctorId)
              || (
                existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.doctorId + '_' + request.resource.data.date + '_' + (request.resource.data.startTime.split(':')[0] + request.resource.data.startTime.split(':')[1])))
                && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.doctorId + '_' + request.resource.data.date + '_' + (request.resource.data.startTime.split(':')[0] + request.resource.data.startTime.split(':')[1]))).data.appointmentId == resource.data.appointmentId
              )
            )
          )
        )
      );

      allow delete: if isOwnerOrReceptionist();
    }

    // --- Doctor Schedules (Booking availability & doctor hours) ---
    match /doctor_schedules/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    // --- Blocked Slots (Doctor breaks and clinic closures) ---
    match /blocked_slots/{id} {
      allow read: if true;
      allow write: if isOwnerOrReceptionist();
    }

    // --- Booking Settings ---
    match /booking_settings/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // --- CMS Collections (Public read for published content; write only for owner/editor; settings only owner) ---

    match /site_settings/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /clinic_info/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /sections/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /services/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /doctors/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /articles/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /faqs/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /ratings/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /image_slots/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /media_files/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /appointment_requests/{id} {
      allow create: if true;
      allow read, update, delete: if isOwnerOrReceptionist();
    }

    match /snapshots/{id} {
      allow read, write: if isOwner();
    }

    match /activity_logs/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isOwner();
    }

    // Everything else denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
