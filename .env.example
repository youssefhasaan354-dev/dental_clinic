# Hayaah Dental Clinic - Environment Variables Template
# Copy this file to .env or .env.local for local overrides. Never commit .env or secrets to git.

# Demo Mode (default: true for sales pitch demo / local preview with zero configuration)
# When no Firebase credentials exist, Demo Mode runs automatically.
VITE_DEMO_MODE=true

# Public canonical site URL (used for absolute og:image, og:url, canonical link, and sitemap)
# Default: https://dentallclinic.vercel.app (do NOT add trailing slash)
VITE_SITE_URL=https://dentallclinic.vercel.app

# Search Engine Indexation Control (Safety safeguard)
# Default: false (emits 'noindex, nofollow' and disallows in robots.txt)
# Set to 'true' in Vercel environment variables only when the clinic approves go-live.
# Note: /admin/* and /booking/manage are ALWAYS noindex, nofollow regardless of this setting.
VITE_ALLOW_INDEXING=false

# Live Production Backend (Firebase: Firestore + Firebase Auth)
# Firebase mode is active ONLY if all four VITE_FIREBASE_* variables are set; otherwise Demo Mode.
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_AUTH_DOMAIN=hayaah-dental.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=hayaah-dental
# VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
